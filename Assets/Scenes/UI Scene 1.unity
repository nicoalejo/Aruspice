  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Salir con Cilindro es raro, es obvio que quien  sea que le haya vendido
    su modulador y simulador de emociones le instal\xF3 solamente la versi\xF3n de
    prueba, el software debe ser excesivamente caro, entonces cada cierto tiempo
    su conversaci\xF3n gira a un anuncio \"\xBFQuieres ir a comer? Conozco un lugar,
    las hamburguesas de Rex Tyler son 100% carne cultivada y ahora est\xE1n con una
    promoci\xF3n de 2x1 en tu primera compra.\" No te lo tomas personal, Cilindro
    es la persona m\xE1s atenta con la que has estado.\"\r\n\r\n\"Es f\xEDsicamente
    incapaz de olvidar algo sobre ti, tiene perfecta memoria de tus gustos, tu cumplea\xF1os,
    tu horario, tus preferencias, puede con solo un vistazo medir tus niveles de
    cortisol, en ese sentido, es perfecto. Ahora lo llevas como una sorpresa al registro
    rob\xF3tico, lo m\xE1s cerca que puede haber del matrimonio entre un humano y
    un robot, tu vida ha cambiado desde que lo conociste, pero solo para mejor.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9f815f4fdd2284770949eb10bbabea12, type: 2}
